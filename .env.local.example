# Copie ce fichier en .env.local (déjà ignoré par git) et renseigne tes
# vraies clés Supabase. Trouve-les dans : Supabase > ton projet >
# Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clé service_role (Project Settings > API > service_role). Ne JAMAIS la
# préfixer NEXT_PUBLIC_ : elle contourne le RLS et ne doit être lue que côté
# serveur (Server Actions / Route Handlers / Server Components), jamais
# exposée au navigateur. Nécessaire à partir du Lot 4 (checkout).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret pour signer les jetons client (historique / messages / position liés à
# un numéro — AUDIT_SECURITE_2). Facultatif : si absent, on retombe sur
# SUPABASE_SERVICE_ROLE_KEY. Ne PAS préfixer NEXT_PUBLIC_.
CLIENT_TOKEN_SECRET=

# Secret pour signer les liens du bon de préparation fournisseur
# (/preparation/<id>?t=<jeton>). Facultatif : repli sur CLIENT_TOKEN_SECRET puis
# SUPABASE_SERVICE_ROLE_KEY. Ne PAS préfixer NEXT_PUBLIC_.
PREPARATION_TOKEN_SECRET=

# Notifications push (PWA) pour l'espace vendeur. Générer la paire une fois avec :
#   npx web-push generate-vapid-keys
# La clé publique doit être exposée au navigateur (préfixe NEXT_PUBLIC_).
# Sans ces variables, le push est simplement inactif (in-app + WhatsApp restent).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact du responsable de l'envoi (exigé par la spec Web Push). Défaut : mailto:unishopsn@gmail.com
VAPID_SUBJECT=

# Numéro WhatsApp d'entreprise SacAdo (format international, chiffres seuls, sans
# +). Sert partout où le client contacte SacAdo et pour les liens de suivi admin
# (TACHE_whatsapp_admin.md §2). Repli sur 221703202150 si absent.
NEXT_PUBLIC_WHATSAPP_SACADO=221703202150

# Secret qui protège la route /api/cron/pushes-differes (drainage des push mis
# en attente pendant les heures calmes, 22h-7h Dakar). Appelée uniquement par le
# pg_cron Supabase `drain_push_differes` (migration 0061), jamais par un client.
CRON_PUSH_SECRET=

# URL publique du site (sans slash final). En dev : http://localhost:3000.
# En prod : le domaine Vercel. Sert de repli pour la redirection OAuth de
# l'espace vendeur ("Continuer avec Google").
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paiement Wave (INTEGRATION_WAVE.md) --------------------------------------
# Partie la plus sensible de l'app. Ces valeurs viennent du compte marchand
# Wave Business (business.wave.com), une fois celui-ci activé. Elles ne doivent
# JAMAIS être préfixées NEXT_PUBLIC_ ni committées : lecture côté serveur seul
# (Server Actions / Route Handlers).
#
# TANT QUE WAVE_API_KEY EST VIDE : mode simulation. Aucun appel réseau à Wave ;
# le checkout redirige vers /paiement/simulation qui rejoue le retour succès /
# annulation ET la logique du webhook. Permet de tester tout le parcours sans
# le compte marchand. Dès que la clé est renseignée, le vrai appel API prend
# le relais.
# De même, tant que WAVE_WEBHOOK_SECRET est vide, /api/wave/webhook accepte
# sans vérifier la signature (dev uniquement).
#
# Clé API secrète (Wave Business > API keys). Sert à créer les sessions de
# paiement (Authorization: Bearer ...).
WAVE_API_KEY=
# Base de l'API Wave. Ne pas modifier sauf indication de Wave.
WAVE_API_BASE_URL=https://api.wave.com/v1
# Secret de signature des webhooks (Wave Business > Webhooks). Sert à vérifier
# la signature HMAC-SHA256 de chaque notification de paiement AVANT de la traiter.
WAVE_WEBHOOK_SECRET=
# Les URLs de retour (succès / annulation) sont construites à partir de
# NEXT_PUBLIC_SITE_URL. Dans la config Wave Business, déclarer l'URL du webhook :
#   <NEXT_PUBLIC_SITE_URL>/api/wave/webhook

# --- Carte de localisation de livraison ---------------------------------------
# Aucune clé : la carte du checkout utilise OpenFreeMap (fonds MapLibre
# gratuits, sans compte ni carte bancaire, servis depuis tiles.openfreemap.org).
# Rien à configurer ici. Si OpenFreeMap est injoignable, le checkout retombe
# automatiquement sur "Utiliser ma position" + placement manuel de l'épingle.

# --- Connexion Google de l'espace vendeur (aucune clé ici) ---------------------
# Le provider Google se configure côté Supabase, pas dans ce fichier :
#   1. Google Cloud Console > APIs & Services > Credentials > OAuth client ID
#      (type "Web application"). Redirect URI autorisée :
#      https://<ref-projet>.supabase.co/auth/v1/callback
#   2. Supabase > Authentication > Providers > Google : activer + coller
#      Client ID et Client Secret.
#   3. Supabase > Authentication > URL Configuration > Redirect URLs : ajouter
#      http://localhost:3000/vendeur/auth/callback et
#      https://<domaine-prod>/vendeur/auth/callback
