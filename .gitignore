# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
.claude/

# captures d'écran de travail à la racine (non versionnées)
/accueil.png
/categorie.png
/sac-decole.png

# manifestes/rapports de scripts ponctuels (scratch local, jamais versionnés)
/cache_dimensions_photos.jsonl
/rapport_photos_sous_400px.jsonl
/reparation_*.jsonl
/remplacement_*.jsonl

# worker MapLibre copié depuis node_modules par scripts/copier-worker-maplibre.mjs
# (regénéré à chaque predev/prebuild — inutile de le versionner)
/public/vendor/

# exports Excel ponctuels à la racine + scripts d'export associés + leurs
# sauvegardes JSON (scratch local, jamais versionnés : sinon `vercel --prod`
# les enverrait aussi, vu qu'il envoie tout le dossier local)
/*.xlsx
/scripts/exporter-*-excel.mjs
/scripts/_backup_*.json

# planches de vérification photo générées localement (pas destinées au site)
/verification_*.html
